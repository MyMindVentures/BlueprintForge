# Server-side only: Railway PostgreSQL connection string.
DATABASE_URL=postgresql://user:password@host:port/database

# Server-side only comma-separated founder identities that resolve Firebase users to ROLE-01.
# Set at least one in Railway production. The legacy default supports the current founder email.
FOUNDER_ADMIN_EMAILS=lacometta33@gmail.com
FOUNDER_ADMIN_UIDS=

# Optional browser-safe debugging. Prefer localStorage blueprintforge.authDebug=true for temporary debugging.
VITE_AUTH_DEBUG=false

# Server-side only OpenRouter proxy key. Do not expose in Vite frontend env vars.
OPENROUTER_API_KEY=

# Server-side only GitHub integration token if enabled.
GITHUB_TOKEN=

# Public app URL used by server-side OpenRouter headers.
APP_URL=http://localhost:3000

# Railway sets PORT automatically; local server defaults to 3000.
PORT=3000
