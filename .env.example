# Server-side only: Railway PostgreSQL connection string.
DATABASE_URL=postgresql://user:password@host:port/database

# Server-side only OpenRouter proxy key. Do not expose in Vite frontend env vars.
OPENROUTER_API_KEY=

# Server-side only GitHub integration token if enabled.
GITHUB_TOKEN=

# Public app URL used by server-side OpenRouter headers.
APP_URL=http://localhost:3000

# Railway sets PORT automatically; local server defaults to 3000.
PORT=3000
