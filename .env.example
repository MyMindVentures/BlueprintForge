# BlueprintForge AI production environment example.
# Copy this file to .env.local for local development and set real values there.
# Never commit real secrets.

# Required: OpenRouter server-side API key for AI ticket polishing and model sync.
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# Required in production deployments.
NODE_ENV=production

# Optional: canonical application URL for OpenRouter referer metadata and callbacks.
APP_URL=https://your-blueprintforge-production-url.example

# Optional: GitHub automation token, only if GitHub issue/PR automation is enabled.
GITHUB_TOKEN=ghp_your_github_token_placeholder

# Optional: persistence/database connection, only if the deployed persistence layer requires it.
DATABASE_URL=postgresql://user:password@host:5432/blueprintforge
